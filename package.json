{
  "name": "macro-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Single-user macro tracker. Device-only, offline-first, installable PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:food-index": "tsx scripts/build-food-index.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@preact/signals": "^2.0.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.0.11",
    "minisearch": "^7.1.2",
    "preact": "^10.26.4",
    "tesseract.js": "^7.0.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.8"
  }
